{
  "name": "playwright-typescript-setup",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "test": "npx playwright test",
    "test:headed": "npx playwright test --headed",
    "test:report": "npx playwright show-report",
    "test:ra101": "npx playwright test tests/modules/RA101 --workers=1 && npm run cleanup:ra101",
    "test:ra101:noclean": "npx playwright test tests/modules/RA101 --workers=1",
    "cleanup:ra101": "python ../tools/data/run_sql.py",
    "install-browsers": "npx playwright install"
  },
  "devDependencies": {
    "@playwright/test": "^1.36.0",
    "dotenv": "^16.6.1",
    "typescript": "^5.4.0"
  }
}
