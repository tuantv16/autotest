# Test Environment Configuration
#
# ─────────────────────────────────────────────────────────────────────────────
# CỔNG (base URL) KHÔNG KHAI Ở ĐÂY NỮA — khai ở project.config.json → "baseUrl".
#
# Một thời điểm chỉ chạy MỘT dự án, và đổi dự án là sửa project.config.json.
# Nếu cổng còn nằm cả ở file này thì đổi dự án phải sửa 2 chỗ; quên chỗ này là
# test chạy trên app của dự án CŨ mà không báo lỗi gì — chỉ fail với lý do vô
# nghĩa. Nên: một cổng, một chỗ khai.
#
# Chỉ mở lại một dòng dưới đây khi cần TẠM trỏ sang host khác (staging, máy
# đồng nghiệp) mà không muốn sửa cấu hình — và nhớ comment lại sau khi xong.
# ─────────────────────────────────────────────────────────────────────────────
#BASE_URL=http://localhost:5173
#BASE_URL=http://10.1.35.120:4173
VITE_API_BASE_URL=http://10.1.35.120:8080/WebAP
PILOT_KEY=prod

# Retail App: cổng lấy từ project.config.json khi dự án Retail được active.
# CẢNH BÁO: giá trị cũ ở đây là 8080 còn cấu hình đang khai 8085 — hai số khác
# nhau, nên đã comment để cấu hình là nguồn duy nhất. Xem const-ra101.ts:11.
#RETAIL_BASE_URL=http://localhost:8080

# Database Configuration
DB_NAME=sessionLocalDB
SESSION_STORE_NAME=sessionData
COMMON_STORE_NAME=commonData

# Default Test Data
DEFAULT_CIPHER=LOCAL_DEV_DUMMY_KEY

# Test Timeouts (ms)
DEFAULT_TIMEOUT=30000
NAVIGATION_TIMEOUT=15000
ACTION_TIMEOUT=10000

#SNAP_DEVICE=pc
SNAP_DEVICE=tablet
#SNAP_DEVICE=all

DEFAULT_PORTRAIT=2 #tablet
#DEFAULT_PORTRAIT=1 #mobile
 #HEADLESS false: open browser window; true: headless mode
HEADLESS=false

# Database của retail_app — dùng bởi fixture `retailData` (tests/utils/db/retail-db.helper.ts)
# để tạo/xóa dữ liệu test. Bỏ trống thì dùng đúng các giá trị dưới đây.
RETAIL_DB_CONTAINER=retail_mysql
RETAIL_DB_USER=laravel
RETAIL_DB_PASSWORD=secret
RETAIL_DB_NAME=laravel
# BẮT BUỘC trên máy dùng Rancher Desktop, nếu không mọi lệnh docker sẽ báo
# "cannot find the file specified" dù container vẫn đang chạy.
DOCKER_CONTEXT=default
